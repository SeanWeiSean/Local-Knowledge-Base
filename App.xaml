<Application x:Class="LocalKnowledgeBase.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 苹果风格颜色 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
            <SolidColorBrush x:Key="AccentBrushHover" Color="#409CFF"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#30D158"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E"/>
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#2C2C2E"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#38383A"/>
            
            <!-- 苹果风格渐变 -->
            <LinearGradientBrush x:Key="AppleGradientBlue" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#007AFF" Offset="0"/>
                <GradientStop Color="#5856D6" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="AppleGradientPurple" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#AF52DE" Offset="0"/>
                <GradientStop Color="#5856D6" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
