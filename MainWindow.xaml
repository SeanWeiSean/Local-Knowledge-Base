<Window x:Class="LocalKnowledgeBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalKnowledgeBase"
        xmlns:converters="clr-namespace:LocalKnowledgeBase.Converters"
        xmlns:vm="clr-namespace:LocalKnowledgeBase.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="本地知识库助手" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True"/>
    </Window.Resources>

    <materialDesign:DialogHost>
        <materialDesign:Card UniformCornerRadius="15" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 自定义标题栏 -->
                <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryDark" Padding="16" 
                                         materialDesign:ElevationAssist.Elevation="Dp4"
                                         CornerRadius="15,15,0,0"
                                         MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <materialDesign:PackIcon Kind="Brain" Width="32" Height="32" 
                                                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="本地知识库助手" 
                                      VerticalAlignment="Center" 
                                      FontSize="20" 
                                      FontWeight="Medium"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                   Click="MinimizeButton_Click"
                                   ToolTip="最小化">
                                <materialDesign:PackIcon Kind="WindowMinimize"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                   Click="MaximizeButton_Click"
                                   ToolTip="最大化">
                                <materialDesign:PackIcon Kind="WindowMaximize"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                   Click="CloseButton_Click"
                                   ToolTip="关闭">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <!-- 主内容 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧知识库 -->
                    <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" 
                           BorderBrush="{DynamicResource MaterialDesignDivider}" 
                           BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderMultiple" Width="24" Height="24" 
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="知识库文档" FontSize="18" FontWeight="Medium" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:ColorZone>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8">
                                <ItemsControl ItemsSource="{Binding Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="4,3" Padding="8" UniformCornerRadius="6">
                                                <materialDesign:Card.Style>
                                                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:Card.Style>
                                                
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocument" 
                                                                               Width="16" Height="16"
                                                                               VerticalAlignment="Center" 
                                                                               Margin="0,0,6,0"
                                                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <TextBlock Text="{Binding FileName}" 
                                                                  FontWeight="SemiBold" 
                                                                  FontSize="13"
                                                                  TextTrimming="CharacterEllipsis" 
                                                                  ToolTip="{Binding FilePath}"
                                                                  VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Command="{Binding DataContext.GenerateSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"
                                                               Margin="0,0,6,0"
                                                               Height="26"
                                                               Padding="8,0"
                                                               FontSize="11"
                                                               Visibility="{Binding IsSummarized, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                                    <Setter Property="Background" Value="#FF5722"/>
                                                                    <Setter Property="BorderBrush" Value="#FF5722"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#F4511E"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="AutoFix" Width="14" Height="14" Margin="0,0,3,0"/>
                                                                <TextBlock Text="生成摘要"/>
                                                            </StackPanel>
                                                        </Button>
                                                        
                                                        <materialDesign:Chip Visibility="{Binding IsSummarized, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                           Margin="0,0,6,0"
                                                                           Height="26"
                                                                           FontSize="11">
                                                            <materialDesign:Chip.Style>
                                                                <Style TargetType="materialDesign:Chip" BasedOn="{StaticResource {x:Type materialDesign:Chip}}">
                                                                    <Setter Property="IconBackground" Value="#4CAF50"/>
                                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                                </Style>
                                                            </materialDesign:Chip.Style>
                                                            <materialDesign:Chip.Icon>
                                                                <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14"/>
                                                            </materialDesign:Chip.Icon>
                                                            已完成
                                                        </materialDesign:Chip>
                                                        
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                               Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"
                                                               Width="26" Height="26"
                                                               Padding="0"
                                                               ToolTip="删除">
                                                            <materialDesign:PackIcon Kind="Delete" 
                                                                                   Width="16" Height="16"
                                                                                   Foreground="{DynamicResource ValidationErrorBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="12">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                       Command="{Binding AddFileCommand}"
                                       Height="48"
                                       materialDesign:ButtonAssist.CornerRadius="24">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePlus" Width="24" Height="24" Margin="0,0,8,0"/>
                                        <TextBlock Text="添加文件" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                       Command="{Binding AddFolderCommand}"
                                       Height="48"
                                       Margin="0,12,0,0"
                                       materialDesign:ButtonAssist.CornerRadius="24">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderPlus" Width="24" Height="24" Margin="0,0,8,0"/>
                                        <TextBlock Text="添加文件夹" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧聊天 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <materialDesign:PackIcon Kind="MessageText" Width="24" Height="24" 
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="智能问答" FontSize="18" FontWeight="Medium" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- 醒目的知识库开关 -->
                                <Border DockPanel.Dock="Right" 
                                       CornerRadius="20" 
                                       Padding="16,8"
                                       Background="#2A2A2A"
                                       BorderThickness="2"
                                       HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#00BCD4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseKnowledgeBase}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#666666"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" Width="24" Height="24" 
                                                               VerticalAlignment="Center" Margin="0,0,10,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="#00BCD4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseKnowledgeBase}" Value="False">
                                                            <Setter Property="Foreground" Value="#666666"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="15">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="知识库模式"/>
                                                    <Setter Property="Foreground" Value="#00BCD4"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseKnowledgeBase}" Value="False">
                                                            <Setter Property="Text" Value="普通对话"/>
                                                            <Setter Property="Foreground" Value="#999999"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ToggleButton IsChecked="{Binding UseKnowledgeBase}"
                                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                     ToolTip="开启：使用知识库回答 | 关闭：纯AI对话"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </materialDesign:ColorZone>

                        <ScrollViewer Grid.Row="1" 
                                    VerticalScrollBarVisibility="Auto" 
                                    Padding="20"
                                    x:Name="ChatScrollViewer">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="User">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            
                                            <Border MaxWidth="550" CornerRadius="18" Padding="14,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FF37474F" Offset="0"/>
                                                                    <GradientStop Color="#FF455A64" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="User">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#FF00BCD4" Offset="0"/>
                                                                            <GradientStop Color="#FF00ACC1" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                                                </Border.Effect>
                                                
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Content}" 
                                                             TextWrapping="Wrap" 
                                                             FontSize="14"
                                                             LineHeight="20"
                                                             Foreground="White"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                                                             FontSize="10" 
                                                             Foreground="#B3FFFFFF"
                                                             Margin="0,6,0,0"
                                                             HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" Padding="20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF263238" Offset="0"/>
                                    <GradientStop Color="#FF1C1C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                       Background="#FF37474F"
                                       CornerRadius="24" 
                                       Padding="20,0"
                                       Margin="0,0,12,0">
                                    <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="14"
                                            Foreground="White"
                                            CaretBrush="White"
                                            VerticalAlignment="Center"
                                            materialDesign:HintAssist.Hint="输入您的问题..."
                                            materialDesign:HintAssist.Foreground="#80FFFFFF"
                                            materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Height="48">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Border>

                                <Button Grid.Column="1" 
                                       Command="{Binding SendMessageCommand}"
                                       Width="56" Height="56"
                                       ToolTip="发送消息 (Enter)"
                                       Style="{StaticResource MaterialDesignFloatingActionButton}">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF00BCD4" Offset="0"/>
                                            <GradientStop Color="#FF00ACC1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <materialDesign:PackIcon Kind="Send" Width="24" Height="24"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>
