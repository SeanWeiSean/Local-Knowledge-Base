<ui:FluentWindow x:Class="LocalKnowledgeBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:LocalKnowledgeBase.Converters"
        mc:Ignorable="d"
        Title="本地知识库助手" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    
    <ui:FluentWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" 
                     Title="本地知识库助手"
                     Icon="pack://application:,,,/icon.ico">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <ui:Button Icon="{ui:SymbolIcon Settings24}" 
                              Appearance="Transparent"
                              Command="{Binding ToggleSettingsCommand}"
                              ToolTip="模型设置"
                              Margin="0,0,4,0"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：知识库文档面板 -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 左侧标题 -->
                    <Border Grid.Row="0" Padding="20,16" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="20" Margin="0,0,12,0"/>
                            <TextBlock Text="知识库文档" 
                                      FontSize="16" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 文档列表 -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12">
                        <ItemsControl ItemsSource="{Binding Documents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 文件名 -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Document24" 
                                                              FontSize="16"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FileName}" 
                                                          FontWeight="Medium"
                                                          FontSize="13"
                                                          TextTrimming="CharacterEllipsis"
                                                          ToolTip="{Binding FilePath}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Row="1" 
                                                       Orientation="Horizontal" 
                                                       Margin="0,10,0,0">
                                                <!-- 生成摘要按钮 -->
                                                <ui:Button Content="生成摘要"
                                                          Icon="{ui:SymbolIcon Sparkle24}"
                                                          Appearance="Primary"
                                                          Command="{Binding DataContext.GenerateSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"
                                                          Visibility="{Binding IsSummarized, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                          FontSize="12"
                                                          Padding="10,6"
                                                          Margin="0,0,6,0"/>

                                                <!-- 已完成标签 -->
                                                <ui:Badge Appearance="Success"
                                                         Visibility="{Binding IsSummarized, Converter={StaticResource BoolToVisibilityConverter}}"
                                                         Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="已完成" FontSize="11"/>
                                                    </StackPanel>
                                                </ui:Badge>

                                                <!-- 删除摘要按钮 -->
                                                <ui:Button Content="删除摘要"
                                                          Icon="{ui:SymbolIcon Delete24}"
                                                          Appearance="Secondary"
                                                          Command="{Binding DataContext.RemoveSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"
                                                          Visibility="{Binding IsSummarized, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          FontSize="12"
                                                          Padding="10,6"
                                                          Margin="0,0,6,0"/>

                                                <!-- 删除文档按钮 -->
                                                <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                                                          Appearance="Secondary"
                                                          Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip="移除文档"
                                                          Padding="6"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 底部操作按钮 -->
                    <StackPanel Grid.Row="2" Margin="16">
                        <ui:Button Content="添加文件"
                                  Icon="{ui:SymbolIcon DocumentAdd24}"
                                  Appearance="Primary"
                                  Command="{Binding AddFileCommand}"
                                  HorizontalAlignment="Stretch"
                                  Height="44"
                                  FontSize="14"/>
                        
                        <ui:Button Content="添加文件夹"
                                  Icon="{ui:SymbolIcon FolderAdd24}"
                                  Appearance="Secondary"
                                  Command="{Binding AddFolderCommand}"
                                  HorizontalAlignment="Stretch"
                                  Height="44"
                                  FontSize="14"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：聊天区域 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 聊天区标题 -->
                <Border Grid.Row="0" Padding="20,16"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="Chat24" FontSize="20" Margin="0,0,12,0"/>
                            <TextBlock Text="智能问答" 
                                      FontSize="16" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 知识库开关 -->
                        <Border DockPanel.Dock="Right" 
                               Background="{DynamicResource ControlFillColorDefaultBrush}"
                               CornerRadius="20"
                               Padding="16,8"
                               BorderThickness="1"
                               HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseKnowledgeBase}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Database24" FontSize="18" Margin="0,0,8,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseKnowledgeBase}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="知识库模式"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseKnowledgeBase}" Value="False">
                                                    <Setter Property="Text" Value="普通对话"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:ToggleSwitch IsChecked="{Binding UseKnowledgeBase}"
                                                ToolTip="开启：使用知识库回答 | 关闭：纯AI对话"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 聊天消息列表 -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             Padding="24"
                             x:Name="ChatScrollViewer">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="User">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    
                                    <Border MaxWidth="600" CornerRadius="16" Padding="16,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="User">
                                                        <Setter Property="Background" Value="{StaticResource AppleGradientBlue}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <StackPanel>
                                            <TextBox Text="{Binding Content, Mode=OneWay}" 
                                                     TextWrapping="Wrap" 
                                                     FontSize="14"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     IsReadOnly="True"
                                                     Cursor="IBeam"
                                                     Padding="0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Setter Property="CaretBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="User">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            
                                            <!-- Token 统计信息 -->
                                            <TextBlock Text="{Binding TokenStats}" 
                                                      FontSize="11" 
                                                      Foreground="{StaticResource AccentBrush}"
                                                      Margin="0,8,0,0"
                                                      Visibility="{Binding TokenStats, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                                                      FontSize="11" 
                                                      Opacity="0.6"
                                                      Margin="0,4,0,0"
                                                      HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="User">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区域 -->
                <Border Grid.Row="2" 
                       Padding="20"
                       Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                   Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="输入您的问题..."
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>

                        <ui:Button Grid.Column="1"
                                  Icon="{ui:SymbolIcon Send24}"
                                  Command="{Binding SendMessageCommand}"
                                  Appearance="Primary"
                                  ToolTip="发送消息 (Enter)"
                                  Width="48"
                                  Height="48"
                                  CornerRadius="24"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 设置面板（弹出层） -->
            <Border Grid.Column="0" 
                   Grid.ColumnSpan="2"
                   Panel.ZIndex="100"
                   Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                   Background="#CC000000">
                <Grid>
                    <!-- 点击外部关闭 -->
                    <Border Background="Transparent">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSettingsCommand}"/>
                        </Border.InputBindings>
                    </Border>
                    
                    <!-- 设置卡片 -->
                    <ui:Card HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Padding="32"
                            Width="480">
                        <StackPanel>
                            <!-- 标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Border Background="{StaticResource AppleGradientBlue}" 
                                       CornerRadius="12" 
                                       Padding="10" 
                                       Margin="0,0,16,0">
                                    <ui:SymbolIcon Symbol="Settings24" 
                                                  FontSize="24" 
                                                  Foreground="White"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="模型设置" 
                                              FontSize="20" 
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="配置本地AI模型参数" 
                                              FontSize="13" 
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- 模型名称 -->
                            <TextBlock Text="模型名称" 
                                      FontSize="13" 
                                      FontWeight="Medium"
                                      Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="例如: qwen3:1.7b, llama2, mistral..."
                                       Margin="0,0,0,20"/>
                            
                            <!-- API 端点 -->
                            <TextBlock Text="Ollama API 端点" 
                                      FontSize="13" 
                                      FontWeight="Medium"
                                      Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="例如: http://localhost:11434/api/chat"
                                       Margin="0,0,0,20"/>
                            
                            <!-- 提示信息 -->
                            <ui:InfoBar IsOpen="True"
                                       IsClosable="False"
                                       Severity="Warning"
                                       Title="提示"
                                       Message="确保Ollama已运行并已下载对应模型。可用 ollama list 查看已安装模型。"
                                       Margin="0,0,0,24"/>
                            
                            <!-- 关闭按钮 -->
                            <ui:Button Content="完成"
                                      Icon="{ui:SymbolIcon Checkmark24}"
                                      Command="{Binding ToggleSettingsCommand}"
                                      Appearance="Primary"
                                      HorizontalAlignment="Stretch"
                                      Height="44"
                                      FontSize="14"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
