<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="本地知识库助手" 
           Manufacturer="LocalKnowledgeBase" 
           Version="1.0.0.0" 
           UpgradeCode="{12345678-1234-1234-1234-123456789012}"
           Language="2052"
           Codepage="65001">
    
    <SummaryInformation Description="本地知识库助手安装程序"
                        Comments="基于Ollama的本地知识库WPF应用程序，支持Word/Excel文档的智能问答"
                        Manufacturer="LocalKnowledgeBase"
                        Keywords="AI,知识库,Ollama,WPF" />

    <MajorUpgrade DowngradeErrorMessage="已安装更新的版本。" />
    
    <MediaTemplate EmbedCab="yes" />
    
    <Feature Id="ProductFeature" Title="本地知识库助手" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- UI配置 -->
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg"
               Control="Next"
               Event="NewDialog"
               Value="InstallDirDlg"
               Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg"
               Control="Back"
               Event="NewDialog"
               Value="WelcomeDlg"
               Order="2">1</Publish>
    </UI>

    <!-- 设置安装目录 -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    
    <!-- 许可协议 -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    
    <!-- 安装图标 -->
    <Icon Id="ProductIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    
    <!-- 添加/删除程序信息 -->
    <Property Id="ARPHELPLINK" Value="https://github.com/SeanWeiSean/Local-Knowledge-Base" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SeanWeiSean/Local-Knowledge-Base" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
  </Package>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="本地知识库助手" />
      </Directory>
      
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="本地知识库助手" />
      </Directory>
      
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="LocalKnowledgeBaseExe" 
              Source="bin\Release\net7.0-windows\publish\LocalKnowledgeBase.exe" 
              KeyPath="yes"
              Checksum="yes">
          <Shortcut Id="MainExeShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="本地知识库助手"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="ProductIcon"
                    IconIndex="0"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- 包含所有发布文件 -->
      <Component Id="ApplicationFiles">
        <File Source="bin\Release\net7.0-windows\publish\*.dll" />
        <File Source="bin\Release\net7.0-windows\publish\*.json" />
        <File Source="bin\Release\net7.0-windows\publish\*.config" />
      </Component>
      
      <!-- README文件 -->
      <Component Id="ReadmeFile">
        <File Id="ReadmeTxt" Source="README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 桌面快捷方式 -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut"
                Name="本地知识库助手"
                Target="[INSTALLFOLDER]LocalKnowledgeBase.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="ProductIcon"
                IconIndex="0" />
      <RemoveFolder Id="RemoveDesktopFolder" Directory="DesktopFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\LocalKnowledgeBase"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- 开始菜单快捷方式 -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder">
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\LocalKnowledgeBase"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
